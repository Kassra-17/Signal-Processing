{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build and run current (auto)",
      "type": "shell",
      "options": { "cwd": "${fileDirname}" },
      "command": "/bin/bash",
      "args": [
        "-lc",
        "ext=\"${fileExtname}\"; \
if [ \"$ext\" = \".c\" ]; then \
  clang -std=c11 \"${fileBasename}\" -lm -o \"${fileBasenameNoExtension}\" && \"./${fileBasenameNoExtension}\"; \
elif [ \"$ext\" = \".cpp\" ]; then \
  VENV=\"/Users/penguin/Desktop/Signal-Processing/.venv\"; \
  PYC=\"/opt/homebrew/bin/python3-config\"; \
  PYP=\"$VENV/bin/python3\"; \
  BASE=$($PYP -c \"import sys; print(sys.base_prefix)\"); \
  SP=$($PYP -c \"import site; print(site.getsitepackages()[0])\"); \
  clang++ -std=c++20 -Wno-deprecated-declarations -Wno-unused-command-line-argument \
    -I/opt/homebrew/include \
    -I\"/Users/penguin/Desktop/Signal-Processing/Signal Processing Projects and Problem Sets/CPP/third_party\" \
    $($PYC --includes) \
    -I$($PYP -c \"import numpy; print(numpy.get_include())\") \
    -L/opt/homebrew/lib $($PYC --embed --ldflags) -Wl,-w \
    \"${fileBasename}\" -lginac -lcln -o \"${fileBasenameNoExtension}\" && \
  PYTHONHOME=\"$BASE\" PYTHONPATH=\"$SP\" \"./${fileBasenameNoExtension}\"; \
else \
  echo \"Unsupported file extension: $ext\"; exit 1; \
fi"
      ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    }
  ]
}